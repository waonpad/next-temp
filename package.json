{
  "name": "next-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "setup": "bun install && cp -n .env.example .env; exit 0",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "biome lint --write . && bun run lint:eslint",
    "lint:eslint": "eslint --fix",
    "lint:circular-deps": "madge --circular src/",
    "check": "biome check --write . && bun run lint:eslint",
    "test": "vitest run",
    "test:watch": "vitest watch --silent",
    "test:ci": "vitest run --silent"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.10",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "happy-dom": "^20.0.11",
    "lefthook": "^2.0.12",
    "madge": "^8.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
